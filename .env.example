# Copiar a .env y ajustar. El fichero .env real esta en .gitignore.

# Clave de la API de inferencia. Vacia o ausente = autenticacion desactivada.
# Con valor, /predict exige la cabecera  X-API-Key: <valor>
API_KEY=cambia-esta-clave

# Solo si se quiere apuntar el pipeline local a otro servidor de MLflow.
# Dentro de docker compose ya se define como http://mlflow:5000
# MLFLOW_TRACKING_URI=http://localhost:5000
