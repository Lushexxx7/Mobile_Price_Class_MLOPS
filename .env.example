# Copiar a .env y ajustar. El fichero .env real esta en .gitignore: nunca se
# commitea, porque es donde acaban las claves.

# Servidor de tracking de MLflow. Tiene prioridad sobre params.yaml.
#
# Sin definir, el proyecto usa SQLite en la raiz del repo, que es lo comodo
# para trabajar en local. Se define cuando hay un servidor aparte: dentro de
# docker compose sera http://mlflow:5000.
# MLFLOW_TRACKING_URI=http://localhost:5000
